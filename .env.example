GEMINI_API_KEY=""

# Auth (defina em `.env.local` e na Vercel)
AUTH_SECRET=""  # openssl rand -base64 32
AUTH_EMAIL=""
AUTH_PASSWORD=""

# Pluggy / MeuPluggy (só servidor; defina em `.env.local` e na Vercel)
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
PLUGGY_WEBHOOK_SECRET=""  # openssl rand -hex 32 — use valores diferentes em dev e produção
# PLUGGY_WEBHOOK_ALLOWED_IPS="52.67.145.81"  # opcional: só aceita webhooks desses IPs

# --- Desenvolvimento ---
# `.env.development` já define:
#   NEXT_PUBLIC_DATA_SOURCE=http
#   DATABASE_URL=file:local.db
# Não coloque o Turso de produção no `.env.local`, senão o dev escreve em prod.

# --- Produção (só na Vercel) ---
# NEXT_PUBLIC_DATA_SOURCE=http
# DATABASE_URL=libsql://orbit-....turso.io
# DATABASE_AUTH_TOKEN=...
